PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/forma_ai
CLIENT_ORIGIN=http://localhost:5173

# LLM provider: "ollama" (default, local, no cost, no rate limit) or "google" (cloud, needs GOOGLE_API_KEY)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=google
GOOGLE_API_KEY=
